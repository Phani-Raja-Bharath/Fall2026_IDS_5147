# Copy this file to `.streamlit/secrets.toml` and paste your real values there.
# The real `secrets.toml` file is ignored by git.

# Preferred for this app: Neon Postgres connection string.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Alias also supported by app.py.
NEON_DATABASE_URL = "postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Optional placeholder if you also keep a Neon API key locally.
# The app does not need this unless you add Neon API management code later.
NEON_API_KEY = "napi_your_neon_api_key_here"

# Set this before using the instructor dashboard.
STATSQUEST_ADMIN_PASSWORD = "replace-with-a-strong-password"
